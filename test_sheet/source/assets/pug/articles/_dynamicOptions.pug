+tab({name:'dynamic options'})
  +select-label({
    inputObj:{name:'equipped gear'},
    spanObj:{'data-i18n':'equipped gear'}
  })
    +option({value:'none','data-i18n':'none'})
    +dynamicOptions({section:'gear',label:'name'})
  +input-label({
    inputObj:{name:'caster level',type:'number',value:1},
